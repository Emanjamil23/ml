{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "cleanUrls": true,
  "rewrites": [
    {
      "source": "/predict",
      "destination": "https://fraud-detection-api-jade.vercel.app/predict"
    },
    {
      "source": "/api/predict",
      "destination": "https://fraud-detection-api-jade.vercel.app/predict"
    },
    {
      "source": "/",
      "destination": "/frontend/index.html"
    },
    {
      "source": "/(.*)",
      "destination": "/frontend/$1"
    }
  ]
}
